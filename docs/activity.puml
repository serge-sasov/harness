@startuml
skinparam defaultFontName Segoe UI
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #555555
skinparam ArrowColor #555555
title Local harness - task plan T-001..T-013

start
:T-001 Git bootstrap\n.gitignore, README; <<#90EE90>>
:T-002 Unified process rules\nharness/process.md; <<#90EE90>>
fork
  :T-003 Board + task cards\ndocs/plan.md, docs/tasks/; <<#90EE90>>
  :T-004 Activity diagram + SVG\nstatus colors; <<#90EE90>>
fork again
  :T-005 Artifact templates\nharness/templates/; <<#90EE90>>
  fork
    :T-006 Sub-agent analyst; <<#90EE90>>
  fork again
    :T-007 Sub-agent architect; <<#90EE90>>
  fork again
    :T-008 Sub-agent coder; <<#90EE90>>
  fork again
    :T-009 Sub-agent qa; <<#90EE90>>
  fork again
    :T-010 Sub-agent doc-writer; <<#90EE90>>
  fork again
    :T-011 Sub-agent orchestrator; <<#90EE90>>
  end fork
end fork
:T-012 opencode commands\nharness-run, harness-board-*; <<#90EE90>>
:T-013 Full-cycle smoke test\npilot task; <<#90EE90>>
stop

legend right
|= Color |= Status |
|<#90EE90>| done |
|<#FFE082>| in_progress |
|<#D3D3D3>| pending |
|<#FF9090>| failed |
|<#FFB347>| blocked |
endlegend
@enduml

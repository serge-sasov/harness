@startuml
autonumber
skinparam defaultFontName Segoe UI
title S-02 Task cycle with checkpoints (feature or bugfix)

actor "User" as user
participant "Command\nharness-run" as cmd
participant "harness\nprimary lead" as lead
participant "harness-orchestrator" as orch
participant "Task role\nharness-*" as role
participant "Board + Checkpoints\n+ ActivityDiagram" as board
participant "Git" as git

user -> cmd : /harness-run T-XXX
cmd -> lead : agent: harness
lead -> board : plan.md + task card + checkpoints
board --> lead : workflow, stage, depends_on,\nacceptance, inputs, checkpoints, status
lead -> lead : load workflows/<workflow>.md\ncheck marker harness/process.md
alt task is awaiting_review
  lead -> board : read CP-N decision + user edits
  board --> lead : approved / changes_requested / none
  alt no decision
    lead --> user : stop: decision required
  else approved
    lead -> orch : resume in_progress
    orch -> board : status + activity + SVG
  else changes_requested
    lead -> orch : resume in_progress
    orch -> board : status + activity + SVG
  end
else task is pending or in_progress
  lead -> board : check dependencies\nand no other active task
  board --> lead : ok / active task ID
  alt not ready
    lead --> user : stop: dependency or active task
  else ready
    lead -> orch : in_progress\nplan + card + activity + SVG
    orch -> board : update status and color
  end
end

loop until final checkpoint CP-F
  lead -> role : task harness-*\ncard, acceptance, inputs, checkpoints
  role -> role : do the stage\nwithin the write area
  role --> lead : result + CHECKPOINT CP-N reached
  lead -> orch : record checkpoint
  orch -> board : checkpoint file\nawaiting_review
  orch -> git : add + commit "T-XXX: checkpoint CP-N"
  git --> orch : snapshot hash
  orch --> lead : checkpoint ready
  lead --> user : CP-N artifacts, checklist,\nhow to edit/comment and resume
  user -> board : review / edit artifacts\nwrite decision in CP-N
  user -> cmd : /harness-run T-XXX
  cmd -> lead : resume task
  lead -> board : read decision and user edits
  alt changes_requested
    lead -> role : apply remarks, return to CP-N
  else approved and more checkpoints remain
    lead -> role : continue to next checkpoint
  end
end

lead -> orch : final acceptance\nCP-F approved
alt acceptance passed
  orch -> board : done + artifacts + log
  orch -> git : add + commit "T-XXX: ..."
  git --> orch : commit hash
  orch --> lead : done, hash
else acceptance failed
  orch -> board : failed, cause in Blockers
  orch --> lead : failed, cause
end
lead --> user : status, checkpoint state,\ncommit, unblocked tasks
note right of lead
  For workflow: bugfix, the BUG-XXX status
  is updated by the orchestrator and the
  coder/QA gates include reproduction,
  failing regression, and fail-before/pass-after.
end note
@enduml

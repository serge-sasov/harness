@startuml
skinparam defaultFontName Segoe UI
skinparam componentStyle rectangle
title Local harness - solution component diagram

actor "User" as user

package "opencode (primary + global harness agents)" {
  component "Commands\nharness-run / harness-board-*" as commands
  component "harness\nprimary lead" as lead
  component "Subagent registry\n~/.config/opencode/agents" as registry
}

package "Harness roles (subagents)" {
  component "harness-orchestrator" as orch
  component "harness-analyst" as analyst
  component "harness-architect" as architect
  component "harness-coder" as coder
  component "harness-qa" as qa
  component "harness-doc-writer" as docwriter
}

package "Local models (Ollama)" {
  component "qwen3.8:27b-64k\nharness / orchestrator /\nanalyst / architect / doc-writer" as qwen
  component "tiel-coder:35b-a3b-mtp-128k\ntext / vision\ncoder / qa" as tiel
}

package "Sources of truth" {
  component "board\ndocs/plan.md" as board
  component "task cards\ndocs/tasks/*.md" as cards
}

package "Artifacts" {
  component "docs/analysis\ndocs/architecture\ndocs/qa\ndocs/guides\ndocs/issues" as docs
  component "src, tests, scripts\nDockerfile, compose" as code
  component "activity.puml / .svg" as activity
}

package "Tools" {
  component "MCP plantuml-render" as puml
  component "local-rag\nSQLite FTS5 + LanceDB" as rag
  component "Git" as git
}

package "Pilot service (T-013)" {
  component "REST API\nFastAPI + Pydantic" as api
  component "NoteService" as svc
  component "NoteRepository\nSQLAlchemy" as repo
  database "SQLite\nvolume /data" as db
}

user --> commands : /harness-init / /harness-run
commands --> lead : agent: harness
lead --> registry : task harness-*
lead --> board : reads board
lead --> cards : reads cards
lead --> qwen
registry --> orch
registry --> analyst
registry --> architect
registry --> coder
registry --> qa
registry --> docwriter

orch --> qwen
analyst --> qwen
architect --> qwen
docwriter --> qwen
coder --> tiel
qa --> tiel

orch --> board : statuses and commits
orch --> cards : acceptance / blockers
orch --> activity : status color
orch --> docs : issue index
orch --> puml : check_syntax / render
orch --> git : add + commit

analyst --> rag : source search
analyst --> docs : requirements
architect --> docs : ADR and diagrams
qa --> docs : review reports
docwriter --> docs : guides and README

coder --> code : implementation and tests
coder --> api : Docker local
api --> svc
svc --> repo
repo --> db

docs --> code : implementation contracts

note right of registry
  Global install:
  agents / commands / skills / harness
  Project activation: /harness-init
end note
@enduml

@startuml
skinparam defaultFontName Segoe UI
skinparam componentStyle rectangle
title Local harness - solution component diagram

actor "User" as user

package "opencode (primary + global harness agents)" {
  component "Commands\nharness-feature / harness-bug /\nharness-run / harness-board-*" as commands
  component "Workflows\nfeature / bugfix" as workflows
  component "harness\nprimary lead" as lead
  component "Subagent registry\n~/.config/opencode/agents" as registry
}

package "Harness roles (subagents)" {
  component "harness-orchestrator" as orch
  component "harness-analyst" as analyst
  component "harness-ux-designer" as ux
  component "harness-architect" as architect
  component "harness-coder" as coder
  component "harness-qa" as qa
  component "harness-qa-vision" as qavision
  component "harness-doc-writer" as docwriter
}

package "Local models (Ollama)" {
  component "qwen3.8:27b-64k\nharness / orchestrator / analyst /\nux-designer / architect / qa / doc-writer" as qwen
  component "tiel-coder:35b-a3b-mtp-128k\ntext / vision\ncoder / qa-vision" as tiel
}

package "Sources of truth" {
  component "workflows\nfeature.md / bugfix.md" as workflowdocs
  component "board\ndocs/plan.md" as board
  component "task cards\ndocs/tasks/*.md" as cards
  component "bug registry\ndocs/bugs/BUG-*.md" as bugs
  component "checkpoints\ndocs/checkpoints/*.md" as checkpoints
}

package "Artifacts" {
  component "docs/analysis\nrequirements + e2e UC + YAML" as docs
  component "docs/ux\nflows / wireframes / UI spec /\nprototype catalog + scenario pages" as uxdocs
  component "docs/architecture\ndocs/qa\ndocs/guides\ndocs/issues" as designdocs
  component "docs/bugs\nBUG cards + index" as bugdocs
  component "src, tests, scripts\nDockerfile, compose" as code
  component "activity.puml / .svg\nderived, informational" as activity
}

package "Tools" {
  component "MCP plantuml-render" as puml
  component "local-rag\nSQLite FTS5 + LanceDB" as rag
  component "Git" as git
}

package "Pilot service (T-013)" {
  component "REST API\nFastAPI + Pydantic" as api
  component "NoteService" as svc
  component "NoteRepository\nSQLAlchemy" as repo
  database "SQLite\nvolume /data" as db
}

user --> commands : /harness-init / /harness-feature\n/harness-bug / /harness-run
commands --> lead : agent: harness
commands --> workflows : selects stage graph
lead --> registry : task harness-*
lead --> workflowdocs : reads selected workflow
lead --> board : reads board
lead --> cards : reads cards
lead --> bugs : reads bug report
lead --> qwen
registry --> orch
registry --> analyst
registry --> ux
registry --> architect
registry --> coder
registry --> qa
registry --> qavision
registry --> docwriter

orch --> qwen
analyst --> qwen
ux --> qwen
architect --> qwen
docwriter --> qwen
coder --> tiel
qavision --> tiel

orch --> board : statuses and commits
orch --> cards : acceptance / blockers
orch --> bugs : triage / status / root cause
orch --> bugdocs : bug cards and index
orch --> checkpoints : awaiting_review / decisions
orch --> activity : derived status color (last)
orch --> designdocs : issue index
orch --> puml : check_syntax / render
orch --> git : add + commit

analyst --> rag : source search
analyst --> docs : requirements + e2e data
ux --> uxdocs : flows, wireframes, UI spec, catalog
ux --> coder : optional task:\nprototype scenario page (depth 2)
coder --> uxdocs : prototype page code\nonly when delegated by UX
architect --> designdocs : ADR and diagrams
architect --> uxdocs : reads screen IDs
qa --> designdocs : e2e plan/report + review
qa --> bugs : reads acceptance
qavision --> uxdocs : visual review
docwriter --> designdocs : guides and README

coder --> code : implementation, unit + e2e tests\nreproduction + regression
coder --> docs : reads e2e data
coder --> bugs : reads report
coder --> api : Docker local
api --> svc
svc --> repo
repo --> db

designdocs --> code : implementation contracts

note right of registry
  Global install:
  agents / commands / skills / workflows / harness
  Project activation: /harness-init
end note

note bottom of activity
  Render from plan/cards/checkpoints/bugs/Git.
  Never use as a status, dependency,
  acceptance, or routing source.
end note
@enduml

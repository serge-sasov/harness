@startuml
skinparam defaultFontName Segoe UI
skinparam componentStyle rectangle
title Локальный harness — компонентная схема решения

actor "Пользователь" as user

package "opencode (primary + глобальные harness-агенты)" {
  component "Команды\nharness-run / harness-board-*" as commands
  component "harness\nprimary lead" as lead
  component "Реестр sub-agents\n~/.config/opencode/agents" as registry
}

package "Роли harness (sub-agents)" {
  component "harness-orchestrator" as orch
  component "harness-analyst" as analyst
  component "harness-architect" as architect
  component "harness-coder" as coder
  component "harness-qa" as qa
  component "harness-doc-writer" as docwriter
}

package "Локальные модели (Ollama)" {
  component "qwen3.8:27b-64k\nharness / orchestrator /\nanalyst / architect / doc-writer" as qwen
  component "tiel-coder:35b-a3b-mtp-128k\ntext / vision\ncoder / qa" as tiel
}

package "Источники истины" {
  component "board\ndocs/plan.md" as board
  component "карточки задач\ndocs/tasks/*.md" as cards
}

package "Артефакты" {
  component "docs/analysis\ndocs/architecture\ndocs/qa\ndocs/guides\ndocs/issues" as docs
  component "src, tests, scripts\nDockerfile, compose" as code
  component "activity.puml / .svg" as activity
}

package "Инструменты" {
  component "MCP plantuml-render" as puml
  component "local-rag\nSQLite FTS5 + LanceDB" as rag
  component "Git" as git
}

package "Пилотный сервис (T-013)" {
  component "REST API\nFastAPI + Pydantic" as api
  component "NoteService" as svc
  component "NoteRepository\nSQLAlchemy" as repo
  database "SQLite\nvolume /data" as db
}

user --> commands : /harness-init / /harness-run
commands --> lead : agent: harness
lead --> registry : task harness-*
lead --> board : читает board
lead --> cards : читает карточки
lead --> qwen
registry --> orch
registry --> analyst
registry --> architect
registry --> coder
registry --> qa
registry --> docwriter

orch --> qwen
analyst --> qwen
architect --> qwen
docwriter --> qwen
coder --> tiel
qa --> tiel

orch --> board : статусы и коммиты
orch --> cards : acceptance / блокеры
orch --> activity : цвет статуса
orch --> docs : issue index
orch --> puml : check_syntax / render
orch --> git : add + commit

analyst --> rag : поиск по источникам
analyst --> docs : требования
architect --> docs : ADR и схемы
qa --> docs : отчёты ревью
docwriter --> docs : гайды и README

coder --> code : реализация и тесты
coder --> api : Docker local
api --> svc
svc --> repo
repo --> db

docs --> code : контракты для реализации

note right of registry
  Глобальная установка:
  agents / commands / skills / harness
  Проект активируется /harness-init
end note
@enduml

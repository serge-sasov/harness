@startuml
autonumber
skinparam defaultFontName Segoe UI
title S-08 Синхронизация board (harness-board-update)

actor "Пользователь" as user
participant "harness\nprimary lead" as lead
participant "harness-orchestrator" as orch
participant "TaskCards\ndocs/tasks" as cards
participant "PlanBoard\ndocs/plan.md" as board
participant "ActivityDiagram\n.puml" as activity
participant "MCP\nplantuml-render" as mcp
participant "Git" as git

user -> lead : /harness-board-update all | T-XXX
lead -> orch : синхронизировать board\n(all или T-XXX)
orch -> cards : прочитать статусы,\nблокеры, коммиты
cards --> orch : фактические статусы
orch -> board : сверить и обновить\nстатус, артефакты, hash
orch -> activity : цвет блока задачи
orch -> mcp : check_syntax
mcp --> orch : valid
orch -> mcp : render_file -> activity.svg
mcp --> orch : SVG
orch -> git : add + commit\n"chore: board update"
git --> orch : hash
orch --> lead : изменённые статусы,\nкоммиты, путь к SVG
lead --> user : отчёт
note right of orch
  При расхождении истиной
  считается карточка задачи
end note
@enduml

@startuml
autonumber
skinparam defaultFontName Segoe UI
title S-08 Board sync (harness-board-update)

actor "User" as user
participant "harness\nprimary lead" as lead
participant "harness-orchestrator" as orch
participant "TaskCards\ndocs/tasks" as cards
participant "PlanBoard\ndocs/plan.md" as board
participant "ActivityDiagram\n.puml" as activity
participant "MCP\nplantuml-render" as mcp
participant "Git" as git

user -> lead : /harness-board-update all | T-XXX
lead -> orch : sync board\n(all or T-XXX)
orch -> cards : read statuses,\nblockers, commits
cards --> orch : actual statuses
orch -> board : reconcile and update\nstatus, artifacts, hash
orch -> activity : task block color
orch -> mcp : check_syntax
mcp --> orch : valid
orch -> mcp : render_file -> activity.svg
mcp --> orch : SVG
orch -> git : add + commit\n"chore: board update"
git --> orch : hash
orch --> lead : changed statuses,\ncommits, SVG path
lead --> user : report
note right of orch
  On divergence, the task card
  is the source of truth
end note
@enduml

@startuml
autonumber
skinparam defaultFontName Segoe UI
title S-05 Implementation, unit and e2e tests (coder)

participant "harness\nprimary lead" as primary
participant "harness-coder" as coder
participant "docs/analysis\ne2e YAML" as data
participant "src / tests / scripts" as code
participant "TestRunner\npytest / lint" as tests
participant "E2E runner\nlocal/staging" as e2e
participant "Docker\nlocal" as docker
participant "harness-orchestrator" as orch

primary -> coder : task: implement per ADR + UX spec
coder -> data : read UC-E2E + dataset
coder -> code : minimal diff\none module per step
coder -> code : tests/e2e + validate-e2e-data.py\n+ scripts/e2e.ps1
coder -> tests : pytest + ruff / mypy
tests --> coder : pass / fail
alt tests or lint failed
  coder -> code : fix\nwithout weakening asserts
  coder -> tests : rerun
end
coder -> docker : docker compose build / up
docker --> coder : service available :8080
coder -> e2e : seed, run, cleanup
e2e --> coder : pass/fail per UC-E2E\n+ evidence paths
alt e2e failed
  coder -> code : fix implementation or test data\n(no assertion weakening)
  coder -> e2e : rerun
end
coder --> orch : files, commands, test/e2e results,\ndeviations from contract
note right of coder
  E2E uses only local/staging resources;
  isolated data with cleanup;
  network and prod actions are forbidden
end note
@enduml

@startuml
autonumber
skinparam defaultFontName Segoe UI
title S-09 Board report (harness-board-report)

actor "User" as user
participant "harness\nprimary lead" as lead
participant "harness-orchestrator" as orch
participant "PlanBoard\ndocs/plan.md" as board
participant "TaskCards\ndocs/tasks" as cards
participant "BugRegistry\ndocs/bugs" as bugs
participant "Report\n(read-only)" as report

user -> lead : /harness-board-report
lead -> orch : read-only board summary
orch -> board : workflows, statuses, dependencies, commits
board --> orch : board rows
orch -> cards : blockers and logs
cards --> orch : causes of failed / blocked
orch -> bugs : bug queue, severity, task links
bugs --> orch : BUG-XXX statuses
orch -> orch : consistency check\n%done, dangling depends_on, bug/task mismatch
orch --> report : task table by workflow\nbug queue, ready to start, blockers
report --> lead : summary + 1..3 recommendations
lead --> user : report
note right of report
  Nothing is changed
  or committed
end note
@enduml

@startuml
skinparam defaultFontName Segoe UI
skinparam classAttributeIconSize 0
title Harness - conceptual class model

enum TaskStatus {
  pending
  in_progress
  awaiting_review
  done
  failed
  blocked
}

enum Workflow {
  feature
  bugfix
}

enum BugStatus {
  new
  triaged
  in_progress
  fixed
  verified
  closed
  duplicate
  wontfix
}

enum Verdict {
  accept
  reject
}

class PlanBoard {
  +source : docs/plan.md
  +load() : TaskCard[]
  +updateStatus(id, status)
  +recordCommit(id, hash)
}

class TaskCard {
  +id : String
  +title : String
  +workflow : Workflow
  +stage : String
  +bug : BugReport
  +role : Role
  +status : TaskStatus
  +dependsOn : TaskCard[]
  +acceptance : String[]
  +artifacts : Path[]
  +blockers : String[]
  +checkpoints : Checkpoint[]
  +inputs : Path[]
  +e2e : Boolean
  +ux : Boolean
  +log : LogEntry[]
  +canStart() : Boolean
  +accept() : Boolean
}

class BugReport {
  +id : String
  +title : String
  +status : BugStatus
  +severity : String
  +observed : String
  +expected : String
  +reproduction : String[]
  +rootCause : String
  +fix : String
  +verification : String
  +duplicateOf : BugReport
  +tasks : TaskCard[]
  +postmortem : String
}

abstract class Role {
  +name : String
  +model : ModelProfile
  +writeZones : Path[]
  +permissions : PermissionSet
  +execute(task) : RoleResult
}

enum CheckpointDecision {
  awaiting_review
  approved
  changes_requested
}

class Checkpoint {
  +id : String
  +stage : String
  +status : CheckpointDecision
  +artifacts : Path[]
  +snapshotCommit : String
  +userRemarks : String
}

class E2EUseCase {
  +id : String
  +actor : String
  +priority : String
  +steps : String[]
  +cleanup : String[]
}

class TestDataset {
  +schema : String
  +useCases : E2EUseCase[]
  +validate() : Boolean
}

class Orchestrator
class Analyst
class UxDesigner
class Architect
class Coder
class QA
class QAVision
class DocWriter

class ModelProfile {
  +name : String
  +thinking : String
  +purpose : String
}

class Artifact {
  +path : Path
  +kind : ArtifactKind
  +producer : Role
}

class Diagram {
  +pumlSource : Path
  +svgRender : Path
  +checkSyntax() : Boolean
  +render() : Path
}

class Review {
  +verdict : Verdict
  +findings : Finding[]
}

class Commit {
  +hash : String
  +message : String
}

class Command {
  +name : String
  +arguments : String
  +run() : Report
}

class HarnessLead {
  +mode : primary
  +checkProject() : Boolean
  +dispatch(role) : RoleResult
}

class LogEntry {
  +date : Date
  +text : String
}

class RoleResult {
  +status : String
  +files : Path[]
  +summary : String
}

class Finding {
  +id : String
  +severity : String
  +text : String
}

Role <|-- Orchestrator
Role <|-- Analyst
Role <|-- UxDesigner
Role <|-- Architect
Role <|-- Coder
Role <|-- QA
Role <|-- QAVision
Role <|-- DocWriter
Role --> ModelProfile
Role ..> RoleResult : returns
TaskCard --> Workflow
TaskCard --> Role
TaskCard --> TaskStatus
TaskCard "0..*" --> "0..*" TaskCard : dependsOn
TaskCard *-- "0..*" LogEntry
TaskCard *-- "1..*" Checkpoint
BugReport --> BugStatus
TaskCard "0..1" --> "1" BugReport : bug
Checkpoint --> CheckpointDecision
Analyst --> E2EUseCase : formalizes
Analyst --> TestDataset : produces
TestDataset *-- "1..*" E2EUseCase
PlanBoard "1" *-- "0..*" TaskCard
Role "1" --> "0..*" Artifact : produces
Artifact <|-- Diagram
Artifact <|-- Review
Review --> Verdict
Review *-- "0..*" Finding
Orchestrator --> PlanBoard : updates
Orchestrator --> BugReport : triages / closes
Orchestrator --> Checkpoint : records decisions
Orchestrator --> Commit : creates
Command --> HarnessLead : selects
HarnessLead --> Workflow : selects
HarnessLead --> Role : dispatches
HarnessLead --> PlanBoard : reads
HarnessLead --> TaskCard : reads
HarnessLead --> BugReport : reads
QA --> Review : produces
QAVision ..> Review : adds visual findings
Diagram ..> Command : rendered by
@enduml

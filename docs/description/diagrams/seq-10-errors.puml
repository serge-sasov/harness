@startuml
autonumber
skinparam defaultFontName Segoe UI
title S-10 Errors, retry <= 3, and blockers

participant "harness\nprimary lead" as primary
participant "harness-orchestrator" as orch
participant "harness-*\ntask role" as role
participant "TaskCard\ndocs/tasks" as card
actor "User" as user

primary -> orch : task result
orch -> orch : acceptance per criteria
alt acceptance passed
  orch -> card : status = done\ntask log
  orch --> primary : done
else acceptance failed
  orch -> card : status = failed\nwhat failed, output, hypothesis
  loop up to 3 fix attempts
    orch -> role : fix\ncause and criteria
    role --> orch : new result
    orch -> orch : re-run acceptance
  end
  alt attempts exhausted
    orch -> card : status = blocked\nescalation
    orch --> user : decision required\nexternal blocker
  else fixed
    orch -> card : status = done\nerror history preserved
  end
end
@enduml

@startuml
autonumber
skinparam defaultFontName Segoe UI
title S-01 Harness onboarding and bootstrap

actor "User" as user
participant "opencode\n(primary build)" as oc
participant "Global harness\n~/.config/opencode" as gh
participant "Ollama" as ollama
participant "Project\nharness/ + docs/" as project

user -> oc : install.ps1 (once)
oc -> gh : agents, commands, skills, workflows,\ntemplates, scripts
oc -> ollama : check qwen3.8 / tiel-coder
ollama --> oc : models available
user -> oc : restart opencode
user -> oc : /harness-init
oc -> gh : read process.md, workflows,\ntemplates, version.json
oc -> project : create harness/process.md,\nharness/workflows/, docs/plan.md,\ndocs/bugs/, activity.puml,\ndocs/ux/, docs/checkpoints/
project --> oc : marker harness/process.md
oc --> user : harness ready\n/harness-feature | /harness-bug\n/harness-run T-XXX
note right of oc
  default_agent is unchanged;
  activation only via explicit /harness-*
end note
@enduml

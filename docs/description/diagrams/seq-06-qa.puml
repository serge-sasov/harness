@startuml
autonumber
skinparam defaultFontName Segoe UI
title S-06 QA-приёмка (qa)

participant "harness\nprimary lead" as primary
participant "harness-qa" as qa
participant "Артефакты\nкод + docs" as store
participant "TestRunner" as tests
participant "Vision\nSVG / PNG" as vision
participant "harness-orchestrator" as orch

primary -> qa : задача: ревью по acceptance
qa -> store : прочитать критерии и артефакты
qa -> tests : независимый прогон тестов
tests --> qa : результаты (read-only)
qa -> vision : проверить схемы
vision --> qa : читаемость и соответствие ADR
qa -> qa : вердикт accept / reject
qa -> store : docs/qa/review-T-XXX.md\nкритерии, замечания, вердикт
qa --> orch : вердикт + severity замечаний
alt reject
  orch --> primary : failed, правки роли-исполнителю
else accept
  orch --> primary : done, замечания minor
end
@enduml

@startuml
autonumber
skinparam defaultFontName Segoe UI
title S-06 QA acceptance (qa)

participant "harness\nprimary lead" as primary
participant "harness-qa" as qa
participant "Artifacts\ncode + docs" as store
participant "TestRunner" as tests
participant "Vision\nSVG / PNG" as vision
participant "harness-orchestrator" as orch

primary -> qa : task: review against acceptance
qa -> store : read criteria and artifacts
qa -> tests : independent test run
tests --> qa : results (read-only)
qa -> vision : inspect diagrams
vision --> qa : readability and ADR compliance
qa -> qa : verdict accept / reject
qa -> store : docs/qa/review-T-XXX.md\ncriteria, findings, verdict
qa --> orch : verdict + finding severity
alt reject
  orch --> primary : failed, fixes to the task role
else accept
  orch --> primary : done, minor findings
end
@enduml

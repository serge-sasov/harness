@startuml
autonumber
skinparam defaultFontName Segoe UI
title S-07 Documentation (doc-writer)

participant "harness\nprimary lead" as primary
participant "harness-doc-writer" as writer
participant "README.md\ndocs/guides" as guides
participant "ADR\ndocs/architecture" as adr
participant "harness-orchestrator" as orch

primary -> writer : task: documentation
writer -> adr : read ADRs and contracts
writer -> guides : README, runbook, guides\nrelative links
writer -> adr : finalize from the template\nwithout changing meaning
writer --> orch : files, changes, links
note right of writer
  Code, tests, and CI/CD
  are not changed
end note
@enduml

@startuml
autonumber
skinparam defaultFontName Segoe UI
title S-11 Пилотный end-to-end цикл T-013

actor "Пользователь" as user
participant "harness-orchestrator" as orch
participant "harness-analyst" as analyst
participant "harness-architect" as arch
participant "MCP\nplantuml-render" as mcp
participant "harness-qa" as qa
participant "docs/analysis,\narchitecture, qa" as pilot
participant "PlanBoard" as board
participant "Git" as git

user -> orch : T-013: smoke-test полного цикла
orch -> analyst : требования пилота\n«Мини-CRUD сервис»
analyst -> pilot : pilot-requirements.md\nR-001..R-006, NFR-1..3
analyst --> orch : требования и риски
orch -> arch : ADR + компонентная схема
arch -> mcp : check_syntax + render
mcp --> arch : pilot-components.svg
arch -> pilot : pilot-adr.md\npilot-components.puml/.svg
arch --> orch : решение и контракт REST
orch -> qa : приёмка артефактов пилота
qa -> pilot : прочитать требования, ADR, схему
qa -> qa : вердикт accept\n2 замечания minor
qa -> pilot : pilot-review.md
qa --> orch : accept
orch -> board : T-013 = done + hash
orch -> git : commit "T-013: ..."
git --> orch : hash
orch --> user : пилотный цикл подтверждён
@enduml

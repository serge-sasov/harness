@startuml
skinparam componentStyle rectangle
skinparam defaultFontName Segoe UI
title Pilot "Mini-CRUD service" - components (ADR-001)

actor "Client" as client
component "REST API\nFastAPI + Pydantic" as api
component "NoteService\ndomain logic" as svc
component "NoteRepository\nSQLAlchemy" as repo
database "SQLite\nvolume /data" as db

client --> api : HTTP/JSON :8080
api --> svc : create/read/update/delete
svc --> repo : CRUD
repo --> db : SQL
@enduml
